DYNAMODB_ENDPOINT=http://localhost:8000
ENVIRONMENT=local
# Per-domain tables (override individually if needed; default to spicycorner-<domain>-<ENVIRONMENT>)
PRODUCTS_TABLE=spicycorner-products-local
ORDERS_TABLE=spicycorner-orders-local
CARTS_TABLE=spicycorner-carts-local
CUSTOMERS_TABLE=spicycorner-customers-local
EVENTS_TABLE=spicycorner-events-local
CONFIG_TABLE=spicycorner-config-local
DEV_AUTH_ENABLED=true
USE_LOCAL_UPLOADS=true
USE_MEMORY_DB=true
LOCAL_API_URL=http://localhost:3001
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
AWS_REGION=us-east-1
# Stripe — set in GitHub Secrets (deployed to Lambda via SAM); publishable key in Amplify
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...  (Amplify only)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Email notifications (contact form, new orders) — NEVER commit real passwords
SMTP_HOST=mail.spicycenter.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=enquiry@spicycenter.com
SMTP_PASS=
SMTP_FROM=enquiry@spicycenter.com
NOTIFY_EMAIL=enquiry@spicycenter.com
# CJ Dropshipping — API Key from My CJ → Authorization → API (not the website password)
CJ_API_KEY=
# Eprolo Open API — from the Eprolo account manager (never commit real values)
EPROLO_OPEN_API_KEY=
EPROLO_OPEN_API_SECRET=
# Optional override if the partner PDF uses a different host
# EPROLO_API_BASE=https://openapi.eprolo.com
